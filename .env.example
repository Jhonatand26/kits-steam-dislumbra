# URL pública del sitio (opcional). Se usa para enlaces absolutos.
# Local:   vacío (astro dev sirve en http://localhost:4321)
# Vercel:  https://<tu-proyecto>.vercel.app  (Settings → Environment Variables)
PUBLIC_SITE_URL=

# Herramienta de inventario (Python, uv). Por defecto usa las rutas del repo.
KITS_DATA_DIR=data/boxes
KITS_SCHEMA=schema/box.schema.json
KITS_INVENTORY_OUT=exports/Separacion_por_caja.xlsx

# Informe PDF de faltantes (Python, uv + XeLaTeX). Rutas por defecto del repo.
KITS_FALTANTES=data/compras/faltantes.json
KITS_INFORME_OUT=exports/Informe_Faltantes_Kits_STEAM.pdf
