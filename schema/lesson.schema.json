{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lección nativa con guía pedagógica",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "firmware", "hardware", "controls", "pedagogy", "parts", "wires", "steps"],
  "properties": {
    "project": { "type": "string", "pattern": "^C[0-9]{2}-P[0-9]+$" },
    "firmware": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+\\.ino$" },
    "hardware": { "$ref": "#/$defs/texts" },
    "controls": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["parameter", "label", "help"],
        "properties": { "parameter": { "$ref": "#/$defs/parameter" }, "label": { "$ref": "#/$defs/text" }, "help": { "$ref": "#/$defs/text" } }
      }
    },
    "parts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/text" }, "type": { "$ref": "#/$defs/text" }, "label": { "$ref": "#/$defs/text" },
          "item": { "$ref": "#/$defs/text" },
          "at": { "$ref": "#/$defs/hole" }, "from": { "$ref": "#/$defs/hole" }, "to": { "$ref": "#/$defs/hole" },
          "plus": { "$ref": "#/$defs/hole" }, "minus": { "$ref": "#/$defs/hole" },
          "ohms": { "type": "number", "exclusiveMinimum": 0 }, "cap": { "$ref": "#/$defs/text" },
          "bind": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/text" } },
          "polarity": {
            "type": "object", "additionalProperties": false, "required": ["parameter", "activeLowWhen"],
            "properties": { "parameter": { "$ref": "#/$defs/parameter" }, "activeLowWhen": { "type": "boolean" } }
          }
        }
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "color"],
        "properties": {
          "id": { "$ref": "#/$defs/text" }, "from": { "$ref": "#/$defs/text" }, "to": { "$ref": "#/$defs/text" }, "color": { "$ref": "#/$defs/text" },
          "when": {
            "type": "object", "additionalProperties": false, "required": ["parameter", "equals"],
            "properties": { "parameter": { "$ref": "#/$defs/parameter" }, "equals": { "type": "boolean" } }
          }
        }
      }
    },
    "steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["title", "body", "show", "focus"],
        "properties": {
          "title": { "$ref": "#/$defs/text" }, "body": { "$ref": "#/$defs/text" },
          "show": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
          "focus": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
          "code": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "pedagogy": {
      "type": "object", "additionalProperties": false,
      "required": ["duration", "question", "goals", "vocabulary", "activities", "evidence", "teacher"],
      "properties": {
        "duration": { "$ref": "#/$defs/text" }, "question": { "$ref": "#/$defs/text" }, "goals": { "$ref": "#/$defs/texts" }, "evidence": { "$ref": "#/$defs/texts" },
        "vocabulary": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["term", "meaning"],
            "properties": { "term": { "$ref": "#/$defs/text" }, "meaning": { "$ref": "#/$defs/text" } }
          }
        },
        "activities": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["title", "predict", "action", "observe", "explain"],
            "properties": { "title": { "$ref": "#/$defs/text" }, "predict": { "$ref": "#/$defs/text" }, "action": { "$ref": "#/$defs/text" }, "observe": { "$ref": "#/$defs/text" }, "explain": { "$ref": "#/$defs/text" } }
          }
        },
        "teacher": {
          "type": "object", "additionalProperties": false, "required": ["preparation", "sequence", "discussion", "assessment"],
          "properties": { "preparation": { "$ref": "#/$defs/texts" }, "sequence": { "$ref": "#/$defs/texts" }, "discussion": { "$ref": "#/$defs/texts" }, "assessment": { "$ref": "#/$defs/texts" } }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "texts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
    "parameter": { "type": "string", "pattern": "^[A-Z][A-Z_0-9]*$" },
    "hole": { "type": "string", "pattern": "^(tp|tn|bp|bn|[a-j])([1-9]|[12][0-9]|30)$" }
  }
}
