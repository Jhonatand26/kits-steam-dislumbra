  "steps": [
    {
      "title": "Conoce las dos bases",
      "body": "Todo el proyecto se arma sobre dos piezas: el Arduino UNO, que es el cerebro, y la protoboard, donde se conectan las piezas sin soldar. Toca cada una para ver qué es y cómo se usa.",
      "show": [
        "uno",
        "bb"
      ],
      "focus": [
        "uno",
        "bb"
      ]
    },
    {
      "title": "Lleva la energía a la protoboard",
      "body": "Con un cable rojo une el pin 5V del Arduino con la línea roja (+) de abajo, y con uno negro el pin GND con la línea azul (−). Luego une las líneas de abajo con las de arriba en las columnas 1 y 2: así toda la tabla tiene energía.",
      "show": [
        "w_5v",
        "w_gnd",
        "w_rail_p",
        "w_rail_n"
      ],
      "focus": [
        "w_5v",
        "w_gnd"
      ]
    },
    {
      "title": "Coloca el LED RGB",
      "body": "Inserta el LED en la fila e, columnas 20 a 23, con la pata más larga en la columna 21. Esa pata es la común: con un cable negro llévala de a21 a la línea azul (−).",
      "show": [
        "rgb",
        "w_k"
      ],
      "focus": [
        "rgb"
      ],
      "code": [
        12,
        14
      ]
    },
    {
      "title": "Protege cada color con una resistencia",
      "body": "Cada color necesita su resistencia de 330 Ω (naranja-naranja-café) para no quemarse. Luego conecta cada resistencia a su pin: rojo al 9, verde al 10 y azul al 11. Estos pines pueden variar el brillo (PWM), por eso los elegimos.",
      "show": [
        "r_rojo",
        "r_verde",
        "r_azul",
        "w_d9",
        "w_d10",
        "w_d11"
      ],
      "focus": [
        "r_rojo",
        "r_verde",
        "r_azul"
      ],
      "code": [
        27,
        31
      ]
    },
    {
      "title": "Instala los tres botones",
      "body": "Pon cada botón sobre el canal central. La pata de arriba a la izquierda va al Arduino (pines 2, 3 y 4) y la de abajo a la derecha, en diagonal, va a la línea azul (−). Tapa azul: 'estoy bien'; amarilla: 'regular'; roja: 'necesito ayuda'.",
      "show": [
        "btn_bien",
        "btn_regular",
        "btn_ayuda",
        "w_d2",
        "w_d3",
        "w_d4",
        "w_g1",
        "w_g2",
        "w_g3"
      ],
      "focus": [
        "btn_bien",
        "btn_regular",
        "btn_ayuda"
      ],
      "code": [
        33,
        38
      ]
    },
    {
      "title": "Agrega el zumbador con su transistor",
      "body": "El pin del Arduino no tiene fuerza suficiente para el zumbador, así que un transistor hace de interruptor. Coloca el 2N2222 en h24-h26 con la cara plana hacia ti, la resistencia de 1 kΩ entre su base y el pin 8, y el zumbador con su pata + en la columna 29. El emisor va a la línea azul (−).",
      "show": [
        "npn",
        "r_base",
        "buzzer",
        "w_d8",
        "w_e",
        "w_bz"
      ],
      "focus": [
        "npn",
        "buzzer"
      ],
      "code": [
        48,
        51
      ]
    },
    {
      "title": "Entiende el programa",
      "body": "Al oprimir un botón, el programa suma un reporte, muestra el color y suena el aviso. El aviso es el mismo para los tres botones, así nadie alrededor sabe qué reportó el estudiante. Arriba del programa están los parámetros: con MODO_DEMO en true el aviso y el color duran más, para mostrarlo a un grupo.",
      "show": [],
      "focus": [],
      "code": [
        4,
        8
      ]
    },
    {
      "title": "Pruébalo",
      "body": "Oprime Iniciar y luego los botones del tablero. El LED muestra el color del reporte y el monitor serie lleva el conteo para el docente. Activa el modo demostración para ver la diferencia.",
      "show": [],
      "focus": [
        "btn_bien",
        "btn_regular",
        "btn_ayuda"
      ],
      "code": [
        52,
        61
      ],
      "run": true
    }
  ]
}
