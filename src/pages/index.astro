---
import Base from "../layouts/Base.astro";
import Resistor from "../components/Resistor.astro";
import Readiness from "../components/Readiness.astro";
import { boxes, bandDigits } from "../lib/boxes";

const base = import.meta.env.BASE_URL;
const nProjects = boxes.reduce((a, b) => a + b.projects.length, 0);
---
<Base title="Kits STEAM · Dislumbra">
  <section class="hero wrap">
    <h1>Qué trae cada caja, cómo se arma y cómo se comprueba que funciona</h1>
    <p class="lead">
      {boxes.length} cajas de kits para secundaria, una por categoría.
      Con lo que trae cada caja se hacen sus proyectos uno tras otro:
      {nProjects} en total, cada uno con su simulación para verlo
      funcionar antes de tocar un cable.
    </p>
  </section>

  <section class="wrap" aria-label="Cajas">
    <ol class="rail">
      {boxes.map((box) => (
        <li class="row" style={`--accent:${box.accent}`}>
          <a class="row-link" href={`${base}${box.slug}/`}>
            <div class="row-res"><Resistor digits={bandDigits(box)} size="lg" /></div>
            <div class="row-main">
              <p class="row-cat muted">{box.category}</p>
              <h2>{box.title}</h2>
              <p class="row-sum">{box.summary}</p>
              <ul class="row-projects">
                {box.projects.map((p) => <li>{p.title}</li>)}
              </ul>
            </div>
            <div class="row-ready"><Readiness box={box} /></div>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 8vw, 5.5rem) 0 2.5rem; }
  .hero h1 { max-width: 18ch; }
  .lead { font-size: 1.2rem; color: var(--ink-2); }

  .rail {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .row { border-bottom: 1px solid var(--line); }
  .row-link {
    display: grid;
    grid-template-columns: 240px 1fr 220px;
    gap: 1.5rem;
    align-items: start;
    padding: 1.8rem 0.25rem;
    color: inherit;
    text-decoration: none;
    border-left: 4px solid transparent;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .row-link:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
    border-left-color: var(--accent);
  }
  .row-res { padding-top: 0.4rem; }
  .row-cat { margin: 0 0 0.2rem; font-size: 0.92rem; }
  .row-main h2 { margin-bottom: 0.3rem; }
  .row-sum { margin-bottom: 0.6rem; }
  .row-projects {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .row-projects li::before { content: "▸ "; color: var(--accent); }
  .row-ready { padding-top: 0.6rem; }

  @media (max-width: 880px) {
    .row-link { grid-template-columns: 1fr; gap: 0.8rem; }
    .row-res :global(svg) { width: 150px; height: auto; }
  }
</style>
