---
import { readiness, STATUS_LABEL, type Box } from "../lib/boxes";

interface Props {
  box: Box;
  legend?: boolean;
}
const { box, legend = false } = Astro.props;
const parts = readiness(box);
const total = box.items.length;
const ready = parts
  .filter((p) => ["en_mano", "verificar", "interno"].includes(p.status))
  .reduce((a, p) => a + p.count, 0);
---
<div class="ready">
  <div class="bar" role="img" aria-label={`${ready} de ${total} ítems listos`}>
    {parts.filter((p) => p.count > 0).map((p) => (
      <span class={`seg s-${p.status}`} style={`flex:${p.count}`} title={`${STATUS_LABEL[p.status]}: ${p.count}`} />
    ))}
  </div>
  <p class="count"><strong>{ready}</strong> de {total} ítems listos</p>
  {legend && (
    <ul class="legend">
      {parts.filter((p) => p.count > 0).map((p) => (
        <li><span class={`dot s-${p.status}`} />{STATUS_LABEL[p.status]} · {p.count}</li>
      ))}
    </ul>
  )}
</div>
<style>
  .bar {
    display: flex;
    gap: 2px;
    height: 10px;
    border-radius: 5px;
    overflow: hidden;
    background: var(--paper-2);
  }
  .seg, .dot { background: var(--line); }
  .s-en_mano { background: var(--ok); }
  .s-verificar { background: var(--check); }
  .s-interno { background: var(--inner); }
  .s-pendiente_compra { background: var(--todo); }
  .s-pendiente_no_electronico { background: var(--todo-soft); }
  .count { margin: 0.35rem 0 0; font-size: 0.95rem; color: var(--ink-2); }
  .legend {
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    font-size: 0.92rem;
  }
  .dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.4rem;
  }
</style>
